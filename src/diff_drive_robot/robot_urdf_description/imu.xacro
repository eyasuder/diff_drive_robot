<?xml version="1.0"?>
<!-- http://wiki.ros.org/urdf/XML/link -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
<xacro:include filename="inertia.xacro"/>
<!-- Define imu properties -->
<xacro:property name="imu_length" value="0.02"/> <!--change to 0.026m-->
<xacro:property name="imu_width" value="0.02"/> <!--change to 0.012m-->
<xacro:property name="imu_height" value="0.01"/> <!--change to 0.01m-->
<xacro:property name="imu_mass" value="0.01"/> 
<xacro:property name="imu_offset_x" value="0.04"/> <!-- relative base link-->
<xacro:property name="imu_offset_y" value="0.01"/> <!-- relative base link-->
<xacro:property name="imu_offset_z" value= "0.16"/> <!-- relative base link-->

<!-- IMU Link -->
<link name="imu_link">
    <visual>
        <geometry>
            <box size ="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
    <material name="Dark"/>
    </visual>
    <collision>
        <geometry>
            <box size ="${imu_length} ${imu_width} ${imu_height}"/>
        </geometry>
    </collision>
    <xacro:imu_inertia mass="${imu_mass}" x="${imu_length}" y="${imu_width}" z="${imu_height}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:imu_inertia>
</link>
    
<!-- IMU joint-->
<joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_offset_x} ${imu_offset_y} ${imu_offset_z}" rpy="0.0 0.0 0.0"/>
</joint>

<gazebo reference="imu_link">
  <material name="Dark"/>
  <sensor name="imu_link" type="imu">
    <always_on>true</always_on>
    <update_rate>100</update_rate>
    <visualize>true</visualize>
    <topic>imu</topic>

    <plugin filename="libignition-gazebo-imu-system.so" 
        name="ignition::gazebo::systems::Imu">
    </plugin>

     <!-- ADD NOISE TO POPULATE COVARIANCES -->
    <imu>
      <angular_velocity>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev> <!-- Variance will be stddev^2 (~4e-8) -->
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>2e-4</stddev>
          </noise>
        </z>
      </angular_velocity>
      <linear_acceleration>
        <x>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev> <!-- Variance will be (~3e-4) -->
          </noise>
        </x>
        <y>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </y>
        <z>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>1.7e-2</stddev>
          </noise>
        </z>
      </linear_acceleration>
      </imu>

    <gz_frame_id>imu_link</gz_frame_id>
  </sensor>
</gazebo>  
</robot>